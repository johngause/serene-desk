---
layout: base.njk
permalink: /cart/
title: Your cart
description: Your Serene Desk cart.
---
{% set noTotals = true %}
<section class="gut cartpage"><div class="wrap">
  <h1>Your cart</h1>
  <div class="cart-grid">
    <div>{% include "summary.njk" %}</div>
    <aside class="cart-side" aria-labelledby="cs-h">
      <h2 id="cs-h">Summary</h2>
      <dl class="totals"><div><dt>Subtotal</dt><dd class="mono subtotal">$165</dd></div></dl>
      <div class="cart-actions">
        <a class="btn lamp" href="{{ '/checkout/' | url }}">Go to checkout</a>
        <a class="textlink" href="{{ '/desks/' | url }}">Keep browsing</a>
      </div>
    </aside>
  </div>
</div></section>
