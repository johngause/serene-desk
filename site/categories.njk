---
layout: base.njk
pagination:
  data: categories
  size: 1
  alias: cat
permalink: "/{{ cat.slug }}/"
eleventyComputed:
  title: "{{ cat.title }}"
  description: "{{ cat.title }} from Serene Desk, with prices and options."
---
<section class="catpage gut"><div class="wrap">
  <div class="shop-head"><h1>{{ cat.title }}</h1></div>
  <h2 class="vh">Products</h2>
  <div class="grid">
    {% for p in products %}{% if p.category == cat.slug %}{% include "card.njk" %}{% endif %}{% endfor %}
  </div>
</div></section>
