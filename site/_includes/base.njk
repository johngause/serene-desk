{% import "art.njk" as a %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | Serene Desk{% else %}Serene Desk{% endif %}</title>
<meta name="description" content="{{ description or 'Serene Desk sells calm standing desks, lamps and small accessories for people who work from home.' }}">
<meta name="theme-color" content="#1E2630">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%231E2630'/%3E%3Ccircle cx='16' cy='12' r='5' fill='%23F3C26B'/%3E%3Cpath d='M6 22H26' stroke='%23E3E7EA' stroke-width='2'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<script>
/* Runs before paint: remembers the dismissed banner and starts the home page with the lamp off (once per session). */
(function(){var h=document.documentElement;h.classList.add("js");
try{if(localStorage.getItem("sd-ann-closed"))h.classList.add("ann-closed")}catch(e){}
{% if bodyClass == "home" %}try{if(!matchMedia("(prefers-reduced-motion: reduce)").matches&&!sessionStorage.getItem("sd-lamp-seen"))h.setAttribute("data-lamp","off")}catch(e){}{% endif %}})();
</script>
<link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
{{ a.sprite() }}
<div class="ann gut" id="ann"><div class="wrap"><p><b>Free delivery on every desk.</b> Try it for 30 nights at home.</p><button type="button" class="annx" id="annx" aria-label="Dismiss announcement"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button></div></div>
<header class="nav gut" id="nav"><div class="wrap">
  <a class="brand" href="{{ '/' | url }}"><svg width="30" height="30" aria-hidden="true"><use href="#mark"/></svg>Serene Desk</a>
  <nav aria-label="Main"><ul class="links">
    <li><a href="{{ '/desks/' | url }}">Desks</a></li>
    <li><a href="{{ '/lighting/' | url }}">Lighting</a></li>
    <li><a href="{{ '/accessories/' | url }}">Accessories</a></li>
    <li><a href="{{ '/help/' | url }}">Help</a></li>
  </ul></nav>
  <a class="cartbtn" href="{{ '/cart/' | url }}" aria-label="Cart, 2 items"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg><span>Cart</span><b class="badge" aria-hidden="true">2</b></a>
</div></header>

<main id="main">
{{ content | safe }}
</main>

<footer class="foot gut"><div class="wrap">
  <p>Serene Desk is a fictional brand created for a product demo.</p>
  <nav aria-label="Footer"><ul class="mono">
    <li><a href="{{ '/shipping/' | url }}">Shipping</a></li>
    <li><a href="{{ '/returns/' | url }}">Returns</a></li>
    <li><a href="{{ '/trial/' | url }}">Trial</a></li>
    <li><a href="{{ '/warranty/' | url }}">Warranty</a></li>
    <li><a href="{{ '/guides/choosing-a-desk-width/' | url }}">Desk width guide</a></li>
    <li><a href="{{ '/about/' | url }}">About</a></li>
    <li><a href="{{ '/help/' | url }}">Help</a></li>
  </ul></nav>
</div></footer>

<script src="{{ '/assets/site.js' | url }}" defer></script>
{% if config.widget == "zendesk" and config.zendeskWidgetKey %}
<script id="ze-snippet" src="https://static.zdassets.com/ekr/snippet.js?key={{ config.zendeskWidgetKey }}"></script>
{% elif config.widget == "custom" %}
{# Phase 4 hook: the custom widget (widget/ dir) loads here. Does nothing yet. #}
<script id="serene-widget-hook">window.SereneWidget = { relayUrl: {{ config.relayUrl | dump | safe }}, agentName: {{ config.agentName | dump | safe }}, loaded: false };</script>
{% endif %}
</body>
</html>
