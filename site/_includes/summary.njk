{% import "art.njk" as a %}
<ul class="lines" id="lines" data-shop="{{ '/desks/' | url }}">
  {% for p in products %}{% if p.id in site.preset %}
  <li class="line" data-id="{{ p.id }}" data-qty="1" data-price="{{ p.sale or p.price }}">
    <div class="lineart grain">{{ a.art(p.art) }}</div>
    <div><p class="name"><a href="{{ ('/products/' + p.slug + '/') | url }}">{{ p.name }}</a></p>
      <p class="sku mono">{{ p.id }}{% if p.finishes.length %} · {{ p.finishes[0].name | capitalize }}{% endif %} · Qty 1</p>
      {% if p.sale %}<p class="saletag mono">Sale price</p>{% endif %}</div>
    <p class="price {% if p.sale %}on{% endif %}">{% if p.sale %}{{ p.sale | money }}<s><span class="vh">was </span>{{ p.price | money }}</s>{% else %}{{ p.price | money }}{% endif %}</p>
  </li>
  {% endif %}{% endfor %}
</ul>
{% if not noTotals %}<dl class="totals"><div><dt>Subtotal</dt><dd class="mono subtotal">$165</dd></div></dl>{% endif %}

<button type="button" class="restore" id="restore" hidden>Restore demo cart</button>
<script type="application/json" id="catalog">{ {%- for p in products %}{{ p.id | dump | safe }}:{"name":{{ p.name | dump | safe }},"slug":{{ p.slug | dump | safe }},"art":{{ p.art | dump | safe }},"price":{{ p.price }},"sale":{{ (p.sale or 0) }}}{% if not loop.last %},{% endif %}{% endfor -%} }</script>
