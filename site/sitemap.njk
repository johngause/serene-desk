---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}{% if item.url and item.url != "/404.html" and item.url != "/sitemap.xml" and not (item.url | truncate(10, true, "") == "/products/") and item.url != "/desks/" %}
  <url><loc>{{ site.origin }}{{ item.url | url }}</loc></url>
{%- endif %}{% endfor %}
{%- for c in categories %}
  <url><loc>{{ site.origin }}{{ ("/" + c.slug + "/") | url }}</loc></url>
{%- endfor %}
{%- for p in products %}
  <url><loc>{{ site.origin }}{{ ("/products/" + p.slug + "/") | url }}</loc></url>
{%- endfor %}
</urlset>
